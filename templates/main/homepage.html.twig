{% extends 'base.html.twig' %}
{% block title %}Starshop: Beam up some parts!{% endblock %}

{% block body %}
<h1>Starshop: your monopoly-busting option for Starship parts!</h1>

<div>
    Browser through {{ numberOfStarship * 10 }} starships!

    {% if numberOfStarship > 400 %}
        <p>
            {# Do you thing "shiploads" will pass the legal team? #}
            That's a shipload of ships!
        </p>
    {% endif %}

    <h2>My Ship</h2>

    <table>
        <tr>
            <th>Name</th>
            <td>{{ myShip.name }}</td>
        </tr>
        <tr>
            <th>Class</th>
            <td>{{ myShip.class }}</td>
        </tr>
        <tr>
            <th>Captain</th>
            <td>{{ myShip.captain|upper }}</td>
        </tr>
        <tr>
            <th>Status</th>
            <td>{{ myShip.status }}</td>
        </tr>
    </table>
</div>

{% endblock %}
